{
  "name": "nestjs-quality-gates",
  "version": "1.0.0",
  "private": true,
  "description": "Dez limites de qualidade para NestJS, cada um provado por um comando.",
  "scripts": {
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "typecoverage": "type-coverage --strict --at-least 100 --ignore-files \"src/**/*.spec.ts\"",
    "lint": "eslint src/",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "estrutura": "ls-lint",
    "halstead": "node tools/halstead.mjs --max 80 'src/**/*.ts'",
    "segredos": "secretlint \"**/*\"",
    "vulns": "npm audit --audit-level=high",
    "sem-atalho": "node tools/sem-atalho.mjs",
    "deadcode": "knip",
    "duplication": "jscpd src --config .jscpd.json",
    "test": "jest",
    "mutation": "stryker run",
    "gates:rapidos": "npm run format:check && npm run typecheck && npm run typecoverage && npm run lint && npm run arch && npm run estrutura && npm run halstead && npm run segredos && npm run sem-atalho && npm run deadcode && npm run duplication && npm test",
    "gates": "npm run gates:rapidos && npm run mutation"
  },
  "devDependencies": {
    "@ls-lint/ls-lint": "2.3.1",
    "@nestjs/common": "11.2.3",
    "@nestjs/core": "11.2.3",
    "@nestjs/cqrs": "11.0.3",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.5",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/jest-runner": "10.0.0",
    "@stryker-mutator/typescript-checker": "10.0.0",
    "@swc/core": "1.13.5",
    "@swc/jest": "0.2.39",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.1",
    "dependency-cruiser": "17.4.3",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jest": "29.16.6",
    "eslint-plugin-sonarjs": "4.2.0",
    "jest": "29.7.0",
    "jscpd": "5.1.1",
    "knip": "6.34.0",
    "prettier": "3.9.6",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "secretlint": "13.0.5",
    "type-coverage": "2.30.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0"
  },
  "engines": {
    "node": ">=22"
  }
}
