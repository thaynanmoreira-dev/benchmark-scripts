#!/usr/bin/env bash
#
# Do zero até rodando, em máquina limpa, sem passo manual.
#
# Se o onboarding do projeto mora em passos não documentados, o agente perde a
# capacidade de validar o que escreveu — e você perde a tarde explicando.
# Rodar duas vezes tem de dar o mesmo resultado.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

echo "==> versão do Node"
node --version
if [ -f .nvmrc ] && command -v nvm >/dev/null 2>&1; then nvm use; fi

echo "==> dependências"
if [ -f package-lock.json ]; then npm ci; else npm install; fi

echo "==> variáveis de ambiente"
if [ -f .env.example ] && [ ! -f .env ]; then
  cp .env.example .env
  echo "    .env criado a partir do exemplo — revise antes de subir o serviço"
fi

# Serviços de apoio. Descomente o que este projeto usa de verdade.
# echo "==> Postgres, Redis e afins"
# docker compose up -d --wait

echo "==> verificação"
npm run gates:rapidos

echo
echo "pronto. Comandos:"
echo "  npm run gates:rapidos   segundos, a cada mudança"
echo "  npm run gates           inclui mutação, antes de entregar"
